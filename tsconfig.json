{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.root.tsbuildinfo",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "exclude": ["node_modules", "apps/web"]
}
