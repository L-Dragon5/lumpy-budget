node_modules/
dist/
.env
.env.local
*.log
.DS_Store
.playwright-mcp/
statements/

# bun.lock is tracked. It is text, it is what makes the Docker build resolve the
# same versions the laptop did, and `--frozen-lockfile` in the Dockerfile turns a
# drifted lockfile into a failed build instead of a silently different image.

# The global ignore file excludes *.sql, which silently swallowed every migration
# in this repo: a fresh clone had no schema to migrate. The migrations ARE the
# schema, so they are re-included here. Dumps from `bun run backup` land in
# ~/lumpy-backups and stay ignored.
!services/db/migrations/*.sql

# The eval fixture is built from the live ledger: real merchant strings, so it
# stays local. `bun run eval:build` rewrites all three together; without them
# `bun run eval:classify` has nothing to score and says so.
services/llm/eval/*.json

backups/
