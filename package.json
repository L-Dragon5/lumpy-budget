{
  "name": "lumpy-budget",
  "private": true,
  "type": "module",
  "workspaces": [
    "contracts",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "migrate": "bun run services/db/src/migrate.ts",
    "seed": "bun run services/db/src/seed.ts",
    "api": "bun run --hot services/api/src/server.ts",
    "web": "bun run --cwd apps/web dev",
    "dev": "bun run api & bun run web",
    "test": "bun test",
    "scenarios": "bun run services/budget-core/scenarios.ts",
    "scenarios:update": "bun run services/budget-core/scenarios.ts --update",
    "demo": "bun run scripts/demo.ts",
    "backup": "bun run scripts/backup.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.app.json",
    "check": "bun run typecheck && bun test && bun run scenarios",
    "build": "bun run --cwd apps/web build",
    "reset": "bun run scripts/reset.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@lumpy/budget-core": "workspace:*",
    "@lumpy/db": "workspace:*"
  }
}
