DATABASE_URL=mysql://root@127.0.0.1:3306/lumpy_budget
TEST_DATABASE_URL=mysql://root@127.0.0.1:3306/lumpy_budget_test
API_PORT=3001

# Optional. Only /api/classify reads it: without it the Categorize page still
# works by hand and the "Suggest categories" button returns a 503 that says so.
# Server-side only; it never reaches the browser.
GEMINI_API_KEY=
# Optional override. `bun run llm:models` lists what the key can reach.
GEMINI_MODEL=

# docker-compose.yml only; the host dev setup ignores all four.
# Alphanumeric, or percent-encode it: it goes into DATABASE_URL as a URL.
MYSQL_ROOT_PASSWORD=
# Required, and not UTC unless you are. MySQL dates rows on the container clock
# and the app compares those dates to its local today, so a UTC container files
# anything entered after 8pm under tomorrow.
TZ=America/New_York
# Host port for the whole app (API + built web on one origin), bound to loopback.
# Nginx Proxy Manager reaches the container over the shared network instead, so
# this is only for curling the server from the server.
PORT=3001
# The Docker network Nginx Proxy Manager is on, which this stack joins rather than
# creates. `docker network ls` names it. NPM forwards to `lumpy` port 3001.
PROXY_NETWORK=proxy
